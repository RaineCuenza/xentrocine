{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "build:watch": "vite build --watch",
        "hot:off": "node -e \"try{require('fs').rmSync('public/hot',{force:true,recursive:true});}catch(e){}\"",
        "dev:cf": "npm run hot:off && npm run build:watch"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "html5-qrcode": "^2.3.8"
    }
}
